<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Coaches</title>
</head>
<body>
    <h1>Coaches</h1>
    <ul>
        <% coaches.forEach(coach => { %>
            <li><%= coach.name %> - <%= coach.experience %> years of experience</li>
        <% }); %>
    </ul>
</body>
</html>
